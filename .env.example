# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# Qwen Cloud / DashScope API key
# Get yours at: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# PostgreSQL connection string
# On Render this is injected automatically via render.yaml
# For local dev: use a local Postgres instance or a free Neon/Supabase DB
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Twilio credentials
# Get yours at: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Admin token — any secret string you choose
# Used to protect the POST /api/reset-db endpoint (X-Admin-Token header)
ADMIN_TOKEN=any_secret_string_you_choose

# Server port (Render overrides this automatically)
PORT=8000
